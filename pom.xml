<?xml version="1.0" encoding="UTF-8"?>
<!-- ===========================================================================
     FICHIER POM PRINCIPAL DU BACKEND MagicLibrary
     Objectif : configuration complète Maven du projet MVP
     Versions sécurisées et disponibles : JJWT 0.11.5, AssertJ 3.26.3
     ========================================================================== -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!-- Version du modèle POM -->
    <modelVersion>4.0.0</modelVersion>

    <!-- =========================================================================
         SPRING BOOT PARENT
         Fournit les configurations par défaut Spring Boot :
         versions compatibles, gestion des dépendances et plugin Maven.
         ========================================================================= -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.12</version>
        <relativePath/>
    </parent>

    <!-- =========================================================================
         INFORMATIONS DU PROJET
         Identité Maven et description du backend MagicLibrary.
         ========================================================================= -->
    <groupId>com.magiclibrary</groupId>
    <artifactId>magiclibrary</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>MagicLibrary Backend MVP</name>
    <description>
        Application back-end du MVP MagicLibrary
        (Java 21 / Spring Boot 3.4.12)
    </description>

    <!-- =========================================================================
         PROPRIÉTÉS
         Version Java et encodages utilisés par Maven.
         ========================================================================= -->
    <properties>
        <java.version>21</java.version>

        <!-- Encodage Maven et ressources -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- =========================================================================
         DÉPENDANCES PRINCIPALES
         Gestion des fonctionnalités techniques et métier de MagicLibrary.
         ========================================================================= -->
    <dependencies>

        <!-- ============================ Spring Data JPA ==========================
             Persistance relationnelle MySQL et MariaDB.
             Utilisée pour USER, ROLE, ITEM, LOAN, LOAN_LINE et NOTIFICATION.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- ============================ MongoDB =================================
             Persistance NoSQL utilisée exclusivement pour le module CONTACT.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- ============================ Spring Security ==========================
             Authentification, autorisation, JWT, sessions SSR et filtres de
             sécurité.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ============================ Validation ===============================
             Validation des DTO et des données entrantes avec Jakarta Validation
             et Hibernate Validator.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================ Spring Web ===============================
             Exposition des contrôleurs REST et SSR avec Tomcat embarqué.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================ Spring Boot Actuator =====================
             Fournit les endpoints techniques de supervision de l'application.

             L'utilisation prévue pour MagicLibrary est limitée à l'endpoint
             de santé /actuator/health, destiné notamment au healthcheck Railway.

             L'ajout de cette dépendance n'expose pas automatiquement tous les
             endpoints : leur exposition et leur sécurisation seront configurées
             séparément dans les propriétés Spring et dans SecurityConfig.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============================ Thymeleaf SSR =============================
             Rendu HTML côté serveur pour les interfaces utilisateurs et
             administrateurs.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ============================ Thymeleaf Security ========================
             Intégration de Spring Security dans les templates Thymeleaf.
             Permet notamment l'utilisation de sec:authorize.
             ===================================================================== -->
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>

        <!-- ============================ MariaDB JDBC ==============================
             Pilote JDBC conservé pour les bases locales MariaDB.

             Spring Boot le sélectionne lorsque l'URL commence par jdbc:mariadb:.
             ===================================================================== -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
        </dependency>

        <!-- ============================ MySQL JDBC ================================
             Pilote JDBC officiel utilisé par la base MySQL Railway.

             Spring Boot le sélectionne lorsque l'URL commence par jdbc:mysql:.
             ===================================================================== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ JJWT ======================================
             Gestion des JSON Web Tokens utilisés pour l'authentification REST.
             Inclut l'API, l'implémentation et l'intégration Jackson.
             ===================================================================== -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.11.5</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.11.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================ OpenAPI / Swagger UI ======================
             Documentation automatique des endpoints REST.
             Version compatible avec Spring Boot 3.4.x.
             ===================================================================== -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.15</version>
        </dependency>

        <!-- ============================ Tests =====================================
             Tests unitaires, tests d'intégration et tests Spring Security.
             ===================================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.26.3</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- =========================================================================
         BUILD ET PLUGINS
         Compilation, packaging exécutable et gestion des ressources Spring Boot.
         ========================================================================= -->
    <build>

        <!-- =====================================================================
             RESSOURCES
             Copie les fichiers de src/main/resources sans filtrage Maven afin
             d'éviter toute altération des propriétés et des commentaires.
             ===================================================================== -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>

            <!-- Création du fichier JAR exécutable Spring Boot. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>